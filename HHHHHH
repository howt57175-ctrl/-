'use client';
import React, { useState, useEffect, useRef } from 'react';
// البريد الإلكتروني المحدد للمالك
const OWNER_EMAIL = 'Agd1279@icloud.com';
interface Message {
id: string;
role: 'user' | 'model';
text: string;
image?: string;
timestamp: string;
}
export default function AuraAIApp() {
// حالة المستخدم والمالك
const [userEmail, setUserEmail] = useState<string>(OWNER_EMAIL);
const [isOwner, setIsOwner] = useState<boolean>(true);
// حالة التبويب النشط
const [activeTab, setActiveTab] = useState<'chat' | 'vision' | 'admin'>('chat');
// حالات المحادثة
const [messages, setMessages] = useState<Message[]>([
{
id: '1',
role: 'model',
text: 'أهلاً بك في تطبيق Aura AI. كيف يمكنني مساعدتك اليوم؟',
timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
}
]);
const [inputPrompt, setInputPrompt] = useState('');
const [isLoading, setIsLoading] = useState(false);
// حالات تحليل الصور (Vision)
const [selectedImage, setSelectedImage] = useState<string | null>(null);
const [imagePrompt, setImagePrompt] = useState('قم بتحليل هذه الصورة واستخراج التفاصيل المهمة منها.');
const [visionResult, setVisionResult] = useState('');
const chatEndRef = useRef<HTMLDivElement>(null);
// التحقق من صلاحيات المالك
useEffect(() => {
if (userEmail.toLowerCase().trim() === OWNER_EMAIL.toLowerCase()) {
setIsOwner(true);
} else {
setIsOwner(false);
}
}, [userEmail]);
// التمرير التلقائي لأسفل الشات
useEffect(() => {
chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
}, [messages, isLoading]);
// 1. إرسال المحادثة النصية للـ API
const handleSendMessage = async () => {
if (!inputPrompt.trim() || isLoading) return;
const userMsg: Message = {
id: Date.now().toString(),
role: 'user',
text: inputPrompt,
timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
};
setMessages(prev => [...prev, userMsg]);
const currentInput = inputPrompt;
setInputPrompt('');
setIsLoading(true);
try {
const response = await fetch('/api/ai/chat', {
method: 'POST',
headers: { 'Content-Type': 'application/json' },
body: JSON.stringify({
prompt: currentInput,
userEmail: userEmail,
history: messages.map(m => ({ role: m.role, text: m.text }))
}),
});
const data = await response.json();
const aiMsg: Message = {
id: (Date.now() + 1).toString(),
role: 'model',
text: data.result || data.error || 'تم استلام الإجابة بنجاح.',
timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
};
setMessages(prev => [...prev, aiMsg]);
} catch (err) {
setMessages(prev => [
...prev,
{
id: (Date.now() + 1).toString(),
role: 'model',
text: 'حدث خطأ في الاتصال بالسيرفر. يرجى التأكد من إعدادات المفتاح API.',
timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
}
]);
} finally {
setIsLoading(false);
}
};
// 2. معالجة رفع الصور
const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
const file = e.target.files?.[0];
if (file) {
const reader = new FileReader();
reader.onloadend = () => {
setSelectedImage(reader.result as string);
};
reader.readAsDataURL(file);
}
};
// 3. تحليل الصورة من خلال السيرفر
const handleAnalyzeImage = async () => {
if (!selectedImage || isLoading) return;
setIsLoading(true);
setVisionResult('');
try {
const response = await fetch('/api/ai/vision', {
method: 'POST',
headers: { 'Content-Type': 'application/json' },
body: JSON.stringify({
image: selectedImage,
prompt: imagePrompt
}),
});
const data = await response.json();
setVisionResult(data.result || data.error || 'تم تحليل الصورة بنجاح.');
} catch (err) {
setVisionResult('حدث خطأ أثناء معالجة تحليل الصورة.');
} finally {
setIsLoading(false);
}
};
return (
<div style={styles.container}>
{/* الشريط العلوي (Header) */}
<header style={styles.header}>
<div style={styles.headerTitle}>
<span style={{ fontSize: '20px' }}>⚡</span>
<h1 style={styles.title}>Aura AI Platform</h1>
</div>
{isOwner && (
<div style={styles.ownerBadge}>
👑 المالك والمسؤول (Super Admin)
</div>
)}
</header>
{/* شريط التنقل بين الأقسام */}
<nav style={styles.navBar}>
<button
style={activeTab === 'chat' ? styles.activeNavBtn : styles.navBtn}
onClick={() => setActiveTab('chat')}
>
💬 المحادثة
</button>
<button
style={activeTab === 'vision' ? styles.activeNavBtn : styles.navBtn}
onClick={() => setActiveTab('vision')}
>
👁️ تحليل الصور (Vision)
</button>
<button
style={activeTab === 'admin' ? styles.activeNavBtn : styles.navBtn}
onClick={() => setActiveTab('admin')}
>
⚙️ لوحة التحكم {isOwner && '🔒'}
</button>
</nav>
{/* محتوى قسم المحادثة */}
{activeTab === 'chat' && (
<main style={styles.mainContent}>
<div style={styles.chatWindow}>
{messages.map(msg => (
<div
key={msg.id}
style={msg.role === 'user' ? styles.userBubbleContainer : styles.aiBubbleContainer}
>
<div style={msg.role === 'user' ? styles.userBubble : styles.aiBubble}>
<p style={{ margin: 0, whiteSpace: 'pre-wrap' }}>{msg.text}</p>
<span style={styles.timestamp}>{msg.timestamp}</span>
</div>
</div>
))}
{isLoading && (
<div style={styles.aiBubbleContainer}>
<div style={styles.aiBubble}>
<p style={{ margin: 0, fontStyle: 'italic', color: '#888' }}>جاري التفكير والتوليد...</p>
</div>
</div>
)}
<div ref={chatEndRef} />
</div>
<div style={styles.inputArea}>
<input
type="text"
placeholder="اكتب سؤالك أو أمرك هنا..."
value={inputPrompt}
onChange={e => setInputPrompt(e.target.value)}
onKeyDown={e => e.key === 'Enter' && handleSendMessage()}
style={styles.input}
/>
<button onClick={handleSendMessage} disabled={isLoading} style={styles.sendBtn}>
إرسال
</button>
</div>
</main>
)}
{/* محتوى قسم تحليل الصور /}
{activeTab === 'vision' && (
<main style={styles.mainContent}>
<div style={styles.visionCard}>
<h3>رفع صورة للتحليل الذكي</h3>
<input type="file" accept="image/" onChange={handleImageUpload} style={{ marginBottom: '15px' }} />
{selectedImage && (
<div style={{ marginBottom: '15px' }}>
<img src={selectedImage} alt="المعاينة" style={{ maxWidth: '100%', maxHeight: '250px', borderRadius: '8px' }} />
</div>
)}
<input
type="text"
value={imagePrompt}
onChange={e => setImagePrompt(e.target.value)}
placeholder="اطلب ماذا تريد أن يحلل الذكاء في الصورة..."
style={styles.input}
/>
<button onClick={handleAnalyzeImage} disabled={!selectedImage || isLoading} style={{ ...styles.sendBtn, marginTop: '10px', width: '100%' }}>
{isLoading ? 'جاري التحليل...' : 'بدء التحليل البصري'}
</button>
{visionResult && (
<div style={styles.resultBox}>
<h4>نتيجة التحليل:</h4>
<p style={{ whiteSpace: 'pre-wrap' }}>{visionResult}</p>
</div>
)}
</div>
</main>
)}
{/* محتوى قسم الإدارة والمالك */}
{activeTab === 'admin' && (
<main style={styles.mainContent}>
<div style={styles.adminCard}>
<h3>إعدادات وتراخيص التطبيق</h3>
<div style={{ marginBottom: '20px' }}>
<label style={{ display: 'block', marginBottom: '5px' }}>البريد الإلكتروني المسجل:</label>
<input
type="email"
value={userEmail}
onChange={e => setUserEmail(e.target.value)}
style={styles.input}
/>
</div>
{isOwner ? (
<div style={styles.ownerControlBox}>
<h4 style={{ color: '#2e7d32', marginTop: 0 }}>🟢 تم التحقق: أنت المالك الرسمي للمشروع</h4>
<ul>
<li>صلاحية التحكم الكاملة: مفعلة</li>
<li>الوصول إلى مفاتيح الـ API: متاح</li>
<li>إدارة نموذج Gemini 2.5/3.8 Flash: نشط</li>
</ul>
</div>
) : (
<div style={styles.userControlBox}>
<h4 style={{ color: '#c62828', marginTop: 0 }}>🔴 حساب مستخدم عادي</h4>
<p>سجل بالبريد الإلكتروني ⁠Agd1279@icloud.com⁠ للوصول لصلاحيات المالك.</p>
</div>
)}
</div>
</main>
)}
</div>
);
}
